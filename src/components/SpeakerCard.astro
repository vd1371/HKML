---
import type { Speaker } from '../lib/types';
const { speaker, index } = Astro.props as { speaker: Speaker; index: number };
const initials = speaker.name.split(/\s+/).map((part) => part[0]).join('').slice(0, 2).toUpperCase();
---

<article class="speaker-card">
  <div class="speaker-identity">
    {speaker.photo ? (
      <img src={speaker.photo} alt={speaker.photoAlt || `Portrait of ${speaker.name}`} width="180" height="180" loading="lazy" decoding="async" />
    ) : (
      <div class="avatar-fallback" aria-hidden="true">{initials || index + 1}</div>
    )}
    <div>
      <span class="speaker-number">Speaker {String(index + 1).padStart(2, '0')}</span>
      <h3>{speaker.name || `Speaker ${index + 1}`}</h3>
    </div>
  </div>
  <div class="speaker-content">
    {speaker.talkTitle && <h4>{speaker.talkTitle}</h4>}
    {speaker.summary && <div><h5>About the talk</h5><p>{speaker.summary}</p></div>}
    {speaker.bio && <div><h5>About the speaker</h5><p>{speaker.bio}</p></div>}
    {speaker.slides && <a class="text-link" href={speaker.slides} target="_blank" rel="noreferrer">View slides <span aria-hidden="true">↗</span></a>}
  </div>
</article>
